[Unit]
Description=TruthSocial Monitor Daemon (@realDonaldTrump)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/equity-research/truthsocial-monitor
EnvironmentFile=/home/ubuntu/.env
ExecStart=/home/ubuntu/equity-research/truthsocial-monitor/.venv/bin/truthsocial-monitor daemon --interval 60 --alert-cooldown 900
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
